FROM python:3.11-slim

WORKDIR /app

# Emit logs immediately so startup and database errors are visible in Compose.
ENV PYTHONUNBUFFERED=1

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

EXPOSE 8000

# Compose runs Alembic first, then starts this same FastAPI application module.
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
