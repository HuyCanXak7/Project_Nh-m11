# MySQL uses the PyMySQL driver already included in backend requirements.
DATABASE_URL=mysql+pymysql://learning_index_user:local_app_password_change_me@localhost:3306/learning_index

# Use a private random value for shared environments; never commit the actual secret.
SECRET_KEY=local_only_replace_with_random_value_at_least_32_bytes
FRONTEND_ORIGIN=http://localhost:8080
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Optional; required only for the demo reset script.
SEED_DEMO_PASSWORD=
