# Safe local-only credentials for the Compose database. Change them for shared environments.
MYSQL_ROOT_PASSWORD=local_root_password_change_me
MYSQL_DATABASE=learning_index
MYSQL_USER=learning_index_user
MYSQL_PASSWORD=local_app_password_change_me

# Backend signing key for local development only. Generate a private key before sharing a deployment.
SECRET_KEY=local_only_replace_with_random_value_at_least_32_bytes
FRONTEND_ORIGIN=http://localhost:8080
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Optional demo seed passwords. Keep empty unless the corresponding seed script is used.
SEED_ADMIN_PASSWORD=
SEED_STUDENT_PASSWORD=
SEED_DEMO_PASSWORD=
