# Database Credentials
MYSQL_ROOT_PASSWORD=root_password_local
MYSQL_DATABASE=my_local_db
MYSQL_USER=mysql_user_local
MYSQL_PASSWORD=mysql_password_local

# Database Connection URL cho Backend 
# (Lưu ý: Bạn có thể đổi 'pymysql' thành driver bạn đang dùng trong code)
DATABASE_URL=mysql+pymysql://mysql_user_local:mysql_password_local@db:3306/my_local_db

# Set a random secret of at least 32 bytes before starting the API.
JWT_SECRET=

# Required only when running the demo account seed.
SEED_ADMIN_PASSWORD=
SEED_STUDENT_PASSWORD=
